// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StudioCliBackend > should write a bootstrap that drives ExecuteRunModeAsync over a result socket 1`] = `
"local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StudioTestService = game:GetService("StudioTestService")
local payload = HttpService:JSONDecode([=[{"pluginKey":"1.2.3-abcdef01","protocolVersion":12,"test":true,"configs":[{"config":{"backend":"studio-cli","bootProbeTimeout":90000,"collectCoverage":false,"color":true,"coverageCache":true,"coverageCopyIgnorePatterns":["**/*.d.ts","**/*.d.ts.map","**/*.luau.map"],"coverageDirectory":"coverage","coveragePathIgnorePatterns":["**/*.spec.lua","**/*.spec.luau","**/*.test.lua","**/*.test.luau","**/node_modules/**","**/rbxts_include/**"],"coverageReporters":["text","lcov"],"passWithNoTests":false,"placeFile":"./game.rbxl","port":3001,"projectTimeout":60000,"rootDir":"/repo","showLuau":true,"silent":false,"sourceMap":true,"testMatch":["**/*.spec.ts","**/*.spec.tsx","**/*.test.ts","**/*.test.tsx","**/*.spec-d.ts","**/*.test-d.ts","**/*.spec-d.luau","**/*.test-d.luau","**/*.spec.lua","**/*.spec.luau","**/*.test.lua","**/*.test.luau"],"testPathIgnorePatterns":["/node_modules/","/dist/","/out/"],"timeout":300000,"uploadCache":true,"verbose":false,"rojoProject":"default.project.json","testNamePattern":"alpha-pattern","runnerJobIndex":0},"runtimeStubMounts":[]}]}]=])
local URL = "ws://localhost:<port>"
local REQUEST_ID = [=[<request-id>]=]
local sideChannelSet, sideChannelError = pcall(function()
	ReplicatedStorage:SetAttribute("JestRobloxRunSideChannel", HttpService:JSONEncode({ payload = payload, requestId = REQUEST_ID, url = URL }))
end)
if not sideChannelSet then
	print("studio-cli: failed to set the run side channel: " .. tostring(sideChannelError))
end
local startedOpened, startedSocket = pcall(function()
	return HttpService:CreateWebStreamClient(Enum.WebStreamClientType.WebSocket, { Url = URL })
end)
if startedOpened then
	startedSocket.Opened:Once(function()
		startedSocket:Send(HttpService:JSONEncode({ type = "started", requestId = REQUEST_ID }))
	end)
	startedSocket.Error:Once(function(_statusCode, errorMessage)
		print("studio-cli: start socket error: " .. tostring(errorMessage))
	end)
else
	print("studio-cli: failed to open start socket: " .. tostring(startedSocket))
end
local ok, result = pcall(function()
	return StudioTestService:ExecuteRunModeAsync(payload)
end)
local message
local keepAlive = false
if not ok then
	message = { type = "results", requestId = REQUEST_ID, gameOutput = "[]", jestOutput = HttpService:JSONEncode({ err = tostring(result), success = false }) }
elseif result == nil then
	-- Remove this keep-alive branch once Roblox fixes
	-- https://devforum.roblox.com/t/executerunmodeasync-returns-nil-when-called-from-task-runscript-before-the-place-reaches-placeidle/4921336
	message = { type = "nilReturn", requestId = REQUEST_ID }
	keepAlive = true
elseif typeof(result) ~= "table" or result.jestOutput == nil then
	message = { type = "results", requestId = REQUEST_ID, gameOutput = "[]", jestOutput = [=[{"err":"studio-cli: the jest plugin produced no result. Install or update the jest-roblox Studio plugin.","success":false}]=] }
else
	message = { type = "results", requestId = REQUEST_ID, protocolVersion = result.protocolVersion, pluginVersion = result.pluginVersion, gameOutput = result.gameOutput or "[]", jestOutput = result.jestOutput }
end
local encoded = HttpService:JSONEncode(message)
local connected, socket = pcall(function()
	return HttpService:CreateWebStreamClient(Enum.WebStreamClientType.WebSocket, { Url = URL })
end)
if not connected then
	print("studio-cli: failed to open result socket: " .. tostring(socket))
	return
end
local finished = false
socket.Opened:Once(function()
	socket:Send(encoded)
end)
socket.Error:Once(function(_statusCode, errorMessage)
	print("studio-cli: result socket error: " .. tostring(errorMessage))
	finished = true
end)
socket.Closed:Once(function()
	finished = true
end)
local start = os.clock()
while not finished and (keepAlive or os.clock() - start < 30) do
	task.wait(0.05)
end
"
`;
