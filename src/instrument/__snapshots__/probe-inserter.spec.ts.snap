exports[`probe-inserter > insertProbes > should insert branch probes at arm body first statements 1`] = `
"if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "test.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 3 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].b == nil then _G.__jest_roblox_cov[__cov_file_key].b = {} end; local __cov_b = _G.__jest_roblox_cov[__cov_file_key].b; if __cov_b[1] == nil then __cov_b[1] = {0, 0} end; __cov_s[1] += 1; if true then
    __cov_b[1][1] += 1; __cov_s[2] += 1; local a = 1
else
    __cov_b[1][2] += 1; __cov_s[3] += 1; local b = 2
end"
`;

exports[`probe-inserter > insertProbes > should preserve the complete instrumentation contract 1`] = `
"--!strict
if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "path\\\\to\\"\\n\\rfile.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 1 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].f == nil then _G.__jest_roblox_cov[__cov_file_key].f = {} end; local __cov_f = _G.__jest_roblox_cov[__cov_file_key].f; for __i = 1, 1 do if __cov_f[__i] == nil then __cov_f[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].b == nil then _G.__jest_roblox_cov[__cov_file_key].b = {} end; local __cov_b = _G.__jest_roblox_cov[__cov_file_key].b; if __cov_b[1] == nil then __cov_b[1] = {0, 0} end; local function __cov_br(__bi, __ai, ...) __cov_b[__bi][__ai] += 1; return ... end; __cov_f[1] += 1; __cov_s[1] += 1; local x = if flag then __cov_br(1, 1, 1) else __cov_br(1, 2, 2)"
`;

exports[`probes in collected fixtures > should produce the expected instrumented source for and-or.luau 1`] = `
"if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "and-or.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 3 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].b == nil then _G.__jest_roblox_cov[__cov_file_key].b = {} end; local __cov_b = _G.__jest_roblox_cov[__cov_file_key].b; if __cov_b[1] == nil then __cov_b[1] = {0, 0} end; if __cov_b[2] == nil then __cov_b[2] = {0, 0} end; if __cov_b[3] == nil then __cov_b[3] = {0, 0} end; if __cov_b[4] == nil then __cov_b[4] = {0, 0} end; local function __cov_br(__bi, __ai, ...) __cov_b[__bi][__ai] += 1; return ... end; __cov_s[1] += 1; local a = __cov_br(1, 1, x) and __cov_br(1, 2, y)
__cov_s[2] += 1; local b = __cov_br(2, 1, p) or __cov_br(2, 2, q)
__cov_s[3] += 1; local c = __cov_br(3, 1, __cov_br(4, 1, i) and __cov_br(4, 2, j)) and __cov_br(3, 2, k)"
`;

