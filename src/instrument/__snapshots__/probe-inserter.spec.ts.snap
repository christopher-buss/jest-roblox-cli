exports[`probes in collected fixtures > should produce the expected instrumented source for expr-if.luau 1`] = `
"if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "expr-if.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 2 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].b == nil then _G.__jest_roblox_cov[__cov_file_key].b = {} end; local __cov_b = _G.__jest_roblox_cov[__cov_file_key].b; if __cov_b[1] == nil then __cov_b[1] = {0, 0} end; if __cov_b[2] == nil then __cov_b[2] = {0, 0, 0} end; local function __cov_br(__bi, __ai, ...) __cov_b[__bi][__ai] += 1; return ... end; __cov_s[1] += 1; local x = if true then __cov_br(1, 1, 1) else __cov_br(1, 2, 2)
__cov_s[2] += 1; local y = if false then __cov_br(2, 1, "a") elseif true then __cov_br(2, 2, "b") else __cov_br(2, 3, "c")"
`;

exports[`probes in collected fixtures > should produce the expected instrumented source for functions.luau 1`] = `
"if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "functions.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 9 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].f == nil then _G.__jest_roblox_cov[__cov_file_key].f = {} end; local __cov_f = _G.__jest_roblox_cov[__cov_file_key].f; for __i = 1, 3 do if __cov_f[__i] == nil then __cov_f[__i] = 0 end end; __cov_s[1] += 1; local function greet(name)
    __cov_f[1] += 1; __cov_s[7] += 1; return "Hello, " .. name
end

__cov_s[2] += 1; local handler = function(x)
    __cov_f[2] += 1; __cov_s[8] += 1; return x * 2
end

__cov_s[3] += 1; function globalFunc()
    __cov_f[3] += 1; __cov_s[9] += 1; print("global")
end

__cov_s[4] += 1; greet("world")
__cov_s[5] += 1; handler(5)
__cov_s[6] += 1; globalFunc()"
`;

exports[`probes in collected fixtures > should produce the expected instrumented source for if-else.luau 1`] = `
"if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "if-else.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 5 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; if _G.__jest_roblox_cov[__cov_file_key].b == nil then _G.__jest_roblox_cov[__cov_file_key].b = {} end; local __cov_b = _G.__jest_roblox_cov[__cov_file_key].b; if __cov_b[1] == nil then __cov_b[1] = {0, 0, 0} end; __cov_s[1] += 1; local x = 1

__cov_s[2] += 1; if x == 1 then
    __cov_b[1][1] += 1; __cov_s[3] += 1; local a = 10
elseif x == 2 then
    __cov_b[1][2] += 1; __cov_s[4] += 1; local b = 20
else
    __cov_b[1][3] += 1; __cov_s[5] += 1; local c = 30
end"
`;

