  __cov_b[1][1] += 1; __cov_s[2] += 1; local y = 2
else __cov_b[1][2] += 1 end"
`;

exports[`probes in collected fixtures > should produce the expected instrumented source for simple.luau 1`] = `
"if _G.__jest_roblox_cov == nil then _G.__jest_roblox_cov = {} end; local __cov_file_key = "simple.luau"; if _G.__jest_roblox_cov[__cov_file_key] == nil then _G.__jest_roblox_cov[__cov_file_key] = {} end; if _G.__jest_roblox_cov[__cov_file_key].s == nil then _G.__jest_roblox_cov[__cov_file_key].s = {} end; local __cov_s = _G.__jest_roblox_cov[__cov_file_key].s; for __i = 1, 3 do if __cov_s[__i] == nil then __cov_s[__i] = 0 end end; __cov_s[1] += 1; local x = 1
