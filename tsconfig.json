{
	"extends": "@isentinel/tsconfig/typescript",
	"compilerOptions": {
		"composite": true,
		"lib": ["es2025", "dom", "webworker"],
		"libReplacement": true,
		"paths": {
			"jest-extended": ["./types/jest-extended.d.ts"]
		},
		"types": [],
		"emitDeclarationOnly": true,
		"outDir": "./out-tsc/config",
		"isolatedDeclarations": false
	},
	"references": [
		{
			"path": "./tsconfig.lib.json"
		},
		{
			"path": "./tsconfig.spec.json"
		}
	],
	"include": [
		"*.config.ts",
		"vitest.shared.ts",
		"vitest.stryker.shared.ts",
		"dependency-cruiser.shared.ts",
		"oxlint.mirror.ts",
		"oxlint.shared.ts"
	]
}
