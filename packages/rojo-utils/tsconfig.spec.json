{
	"extends": "@isentinel/tsconfig/typescript",
	"compilerOptions": {
		"composite": true,
		"lib": ["esnext"],
		"libReplacement": true,
		// The monorepo swaps jest-extended's own types for the repo-root
		// replacement in tsconfig.node.json, which every package spec project
		// inherits. This one extends the shared base directly, so it restates
		// the swap; without it the `declare module "vitest"` augmentation never
		// loads and every jest-extended matcher error-types.
		"paths": {
			"*": ["${configDir}/*"],
			"jest-extended": ["../../types/jest-extended.d.ts"]
		},
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "./out-tsc/vitest"
	},
	"references": [
		{
			"path": "./tsconfig.lib.json"
		}
	],
	"include": [
		"eslint.config.ts",
		"vitest.config.ts",
		"tsdown.config.ts",
		"package.json",
		"src/**/*.spec.ts",
		"src/**/*.spec-d.ts",
		"test/**/*.ts",
		"test/**/*.d.ts"
	]
}
