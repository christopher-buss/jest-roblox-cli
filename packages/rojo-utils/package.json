{
	"name": "@isentinel/rojo-utils",
	"version": "0.1.0",
	"private": true,
	"description": "Rojo tree walking, nested project resolution, and DataModel path mapping",
	"keywords": [
		"roblox",
		"rojo",
		"datamodel",
		"tree"
	],
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./test/*.ts"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"boundaries": "cd ../.. && dependency-cruiser --config packages/rojo-utils/dependency-cruiser.config.ts --output-type err -- packages/rojo-utils/src packages/rojo-utils/test",
		"build": "tsdown",
		"cpd": "pnpm cpd-production && pnpm cpd-spec",
		"cpd-production": "jscpd --config .jscpd.json --no-tips",
		"cpd-spec": "jscpd --config .jscpd.spec.json --no-tips",
		"integration": "vitest run --project integration --coverage.enabled=false",
		"knip": "pnpm knip-production && cd ../.. && knip --config packages/rojo-utils/knip.json --workspace packages/rojo-utils",
		"knip-production": "cd ../.. && knip --production --config packages/rojo-utils/knip.json --workspace packages/rojo-utils",
		"lint": "oxlint && eslint --cache",
		"mutation": "stryker run stryker.config.ts",
		"test": "vitest run --project unit --project type --coverage",
		"test-type": "vitest run --project type",
		"test-unit": "vitest run --project unit --coverage.enabled=false",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"arktype": "2.2.3"
	},
	"devDependencies": {
		"@isentinel/eslint-config": "6.2.0",
		"@isentinel/tsconfig": "2.0.0",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/typescript-checker": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@total-typescript/shoehorn": "0.1.2",
		"@types/node": "24.12.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/eslint-plugin": "1.6.27",
		"eslint": "10.9.0",
		"eslint-plugin-jest-extended": "3.0.1",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-pnpm": "1.8.0",
		"jest-extended": "7.0.0",
		"knip": "6.29.0",
		"memfs": "4.68.1",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"engines": {
		"node": ">=24.12.0"
	}
}
