{
	"name": "@isentinel/roblox-runner",
	"version": "0.1.0",
	"private": true,
	"description": "OCALE transport for Roblox remote execution",
	"keywords": [
		"roblox",
		"open-cloud",
		"ocale",
		"runner"
	],
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#src/*": "./src/*",
		"#test/*": "./test/*"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./testing": {
			"source": "./src/testing.ts",
			"types": "./dist/testing.d.mts",
			"default": "./dist/testing.mjs"
		}
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"boundaries": "cd ../.. && dependency-cruiser --config packages/roblox-runner/dependency-cruiser.config.ts --output-type err -- packages/roblox-runner/src packages/roblox-runner/test",
		"build": "tsdown",
		"cpd": "pnpm cpd-production && pnpm cpd-spec",
		"cpd-production": "jscpd --config .jscpd.json --no-tips",
		"cpd-spec": "jscpd --config .jscpd.spec.json --no-tips",
		"integration": "vitest run --project integration --coverage.enabled=false",
		"knip": "pnpm knip-production && cd ../.. && knip --config packages/roblox-runner/knip.json --workspace packages/roblox-runner",
		"knip-production": "cd ../.. && knip --production --config packages/roblox-runner/knip.json --workspace packages/roblox-runner",
		"lint": "oxlint && eslint --cache",
		"mutation": "stryker run stryker.config.ts",
		"test": "vitest run --project unit --project type --coverage",
		"test-type": "vitest run --project type",
		"test-unit": "vitest run --project unit --coverage.enabled=false",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@bedrock-rbx/ocale": "0.3.4",
		"arktype": "2.2.3"
	},
	"devDependencies": {
		"@isentinel/eslint-config": "7.1.0",
		"@isentinel/tsconfig": "3.0.0",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/typescript-checker": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@total-typescript/shoehorn": "0.1.2",
		"@types/node": "24.12.3",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"dependency-cruiser": "18.4.0",
		"eslint": "10.15.0",
		"eslint-plugin-jest-extended": "3.0.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-pnpm": "1.8.0",
		"jest-extended": "7.0.0",
		"jscpd": "5.4.1",
		"knip": "6.29.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
	"engines": {
		"node": ">=24.12.0"
	}
}
