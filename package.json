{
	"name": "@isentinel/jest-roblox",
	"version": "0.3.16",
	"description": "Jest-compatible CLI for running roblox-ts tests via Roblox Open Cloud",
	"keywords": [
		"jest",
		"roblox",
		"rbxts",
		"testing",
		"cli"
	],
	"homepage": "https://github.com/christopher-buss/jest-roblox-cli#readme",
	"bugs": {
		"email": "christopher.buss@pm.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/christopher-buss/jest-roblox-cli.git"
	},
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"source": "./src/source.ts",
			"default": "./dist/index.mjs"
		},
		"./artifacts": {
			"source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./cli": {
			"source": "./src/cli.ts",
			"default": "./dist/cli.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"bin": {
		"jest-roblox": "./bin/jest-roblox.js"
	},
	"files": [
		"bin",
		"dist",
		"loaders",
		"plugin",
		"!dist/sea",
		"!dist/**/*.map",
		"!dist/**/*.tsbuildinfo"
	],
	"scripts": {
		"bench": "vitest bench --project \"unit (bench)\"",
		"build": "pnpm build:packages && pnpm build:bundle && tsdown && pnpm build:plugin",
		"build:bundle": "weld",
		"build:packages": "pnpm -r --filter !@isentinel/jest-roblox run build",
		"build:plugin": "rojo build plugin/plugin.project.json -o plugin/JestRobloxRunner.rbxm",
		"lint": "eslint --cache",
		"lint:ci": "eslint --cache --cache-strategy content",
		"prepack": "pnpm build",
		"prepublishOnly": "pnpm build",
		"release": "bumpp",
		"test": "nr typecheck && vitest run --coverage",
		"typecheck": "tsgo --build --emitDeclarationOnly",
		"watch": "tsdown --watch"
	},
	"dependencies": {
		"@bedrock-rbx/ocale": "0.1.5",
		"@jridgewell/trace-mapping": "0.3.31",
		"arktype": "2.2.0",
		"c12": "4.0.0-beta.5",
		"confbox": "0.2.4",
		"defu": "6.1.7",
		"get-tsconfig": "4.14.0",
		"highlight.js": "11.11.1",
		"istanbul-lib-coverage": "3.2.2",
		"istanbul-lib-report": "3.0.1",
		"istanbul-reports": "3.2.0",
		"oxc-parser": "0.123.0",
		"picomatch": "4.0.4",
		"std-env": "4.1.0",
		"tinyrainbow": "3.1.0",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@isentinel/eslint-config": "6.0.0-beta.36",
		"@isentinel/luau-ast": "workspace:*",
		"@isentinel/roblox-runner": "workspace:*",
		"@isentinel/roblox-ts": "4.0.11",
		"@isentinel/rojo-utils": "workspace:*",
		"@isentinel/tsconfig": "2.0.0",
		"@isentinel/weld": "0.2.0",
		"@oxc-project/types": "0.123.0",
		"@rbxts/jest": "3.16.0-ts.1",
		"@rbxts/types": "latest",
		"@total-typescript/shoehorn": "0.1.2",
		"@tsdown/exe": "0.22.14",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/istanbul-lib-report": "3.0.3",
		"@types/istanbul-reports": "3.0.4",
		"@types/node": "24.12.3",
		"@types/picomatch": "4.0.3",
		"@types/ws": "8.18.1",
		"@typescript/native-preview": "7.0.0-dev.20260607.1",
		"@vitest/coverage-v8": "5.0.0-beta.7",
		"@vitest/eslint-plugin": "1.6.19",
		"better-typescript-lib": "2.12.0",
		"bumpp": "11.1.0",
		"eslint": "10.7.0",
		"eslint-plugin-jest-extended": "3.0.1",
		"eslint-plugin-n": "18.2.2",
		"eslint-plugin-pnpm": "1.7.0",
		"jest-extended": "7.0.0",
		"memfs": "4.57.2",
		"publint": "0.3.21",
		"tsdown": "0.22.14",
		"type-fest": "5.7.0",
		"typescript": "6.0.3",
		"vitest": "5.0.0-beta.7"
	},
	"peerDependencies": {
		"@typescript/native-preview": ">=7.0.0-0"
	},
	"peerDependenciesMeta": {
		"@typescript/native-preview": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"engines": {
		"node": ">=24.12.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./artifacts": "./dist/index.mjs",
			"./cli": "./dist/cli.mjs",
			"./package.json": "./package.json"
		}
	}
}
